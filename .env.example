# =============================================================
# Подключения к БД: только ПЕРВИЧНЫЙ ЗАСЕВ.
#
# Список подключений живёт в config_data/db_profiles.json и редактируется
# на странице "Настройки" (добавление, правка, удаление). Переменные DB_*
# читаются ровно один раз — когда этого файла ещё нет; из них создаются
# подключения grom-tk / grom-prod / grom-my. После этого .env на список
# не влияет, и переменные можно удалить.
#
# Все три набора необязательны: набор с отсутствующей или нечисловой
# переменной просто пропускается, приложение стартует.
# =============================================================

# Засев подключения "grom-tk"
DB_HOST=
# 6432 = pgbouncer (пул соединений), 5432 = прямой postgres.
# Комментарий отдельной строкой: docker run --env-file не срезает инлайн-комментарии
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Засев подключения "grom-prod"
DB_HOST_PROD=
DB_PORT_PROD=
DB_USER_PROD=
DB_PASSWORD_PROD=
DB_NAME_PROD=

# Засев подключения "grom-my"
DB_HOST_MY=
DB_PORT_MY=
DB_USER_MY=
DB_PASSWORD_MY=
DB_NAME_MY=

# =============================================================
# Jira (выбор вложения задачи вместо файла с диска на страницах парсеров).
# =============================================================
JIIRA_HOST=
JIIRA_PORT=
JIIRA_USER=
JIIRA_PASSWORD=

# =============================================================
# Веб-сервер и сессии
# =============================================================
SERVER_PORT=8011

# Секрет для подписи cookie-сессии и CSRF-токена (см. app.py).
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Уровень логирования (DEBUG, INFO, WARNING, ERROR). По умолчанию INFO.
LOG_LEVEL=INFO

# =============================================================
# MCP: postgres-grom-my_test (.mcp.json) — read-only доступ для Claude Code.
# =============================================================
MCP_POSTGRES_URI=postgresql://claude_ro:PASSWORD@localhost:6432/grom
