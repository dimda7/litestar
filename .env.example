# =============================================================
# DB connections: FIRST-TIME SEEDING ONLY.
#
# The list of connections lives in config_data/db_profiles.json and is edited
# on the "Настройки" page (add, edit, delete). The DB_* variables are read
# exactly once — while that file does not exist yet — and the grom-tk /
# grom-prod / grom-my connections are created from them. After that .env has
# no influence on the list and the variables can be removed.
#
# All three sets are optional: a set with a missing or non-numeric variable is
# simply skipped and the app still starts.
# =============================================================

# Seeds the "grom-tk" connection
DB_HOST=
# 6432 = pgbouncer (connection pool), 5432 = postgres direct.
# Kept on its own line: docker run --env-file does not strip inline comments
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Seeds the "grom-prod" connection
DB_HOST_PROD=
DB_PORT_PROD=
DB_USER_PROD=
DB_PASSWORD_PROD=
DB_NAME_PROD=

# Seeds the "grom-my" connection
DB_HOST_MY=
DB_PORT_MY=
DB_USER_MY=
DB_PASSWORD_MY=
DB_NAME_MY=

# =============================================================
# Jira (picking an issue attachment instead of a local file on the parser pages).
# =============================================================
JIIRA_HOST=
JIIRA_PORT=
JIIRA_USER=
JIIRA_PASSWORD=

# =============================================================
# Web server and sessions
# =============================================================
SERVER_PORT=8011

# Secret signing the session cookie and the CSRF token (see app.py).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Log level (DEBUG, INFO, WARNING, ERROR). Defaults to INFO.
LOG_LEVEL=INFO

# =============================================================
# MCP: postgres-grom-my_test (.mcp.json) — read-only access for Claude Code.
# =============================================================
MCP_POSTGRES_URI=postgresql://claude_ro:PASSWORD@localhost:6432/grom
